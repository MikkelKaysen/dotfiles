{
  "$schema": "https://opencode.ai/config.json",
  "model": "itm-gw/qwen3.8",
  "plugins": ["opencode-plugin-litellm", "opencode-models-discovery"],
  "providers": {
    "itm-gw": {
      "package": "@ai-sdk/openai-compatible",
      "name": "IT Minds LLM Gateway",
      "settings": {
        "litellm": true,
        "baseURL": "{env:ITM_LLM_GW_URL}",
        "apiKey": "{env:ITM_LLM_GW_KEY}",
      },
    },
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "github-copilot",
      "effect": "deny",
    },
  ],
  "agents": {
    "build": { "model": "itm-gw/qwen3.8" },
    "plan": { "model": "itm-gw/glm-5.3" },
    "quick-message": { "model": "itm-gw/deepseek-v4.1-flash" },
    "refactorer": { "model": "itm-gw/qwen3.8" },
    "debugger": { "model": "itm-gw/qwen3.8" },
    "security-auditor": { "model": "itm-gw/qwen3.8" },
    "commit-message": { "model": "itm-gw/gemma-4-26b" },
    "tool-runner": { "model": "itm-gw/qwen3.6-35b" },
  },
}
