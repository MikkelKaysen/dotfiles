{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "medium",
    "image_preview": false,
    "permissions": "autoaccept"
  },
  "animations": true,
  "prompt": {
    "image_preview": true
  }
}
