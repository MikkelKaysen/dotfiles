{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "quick-message",
  "plugins": ["opencode-models-discovery", "./plugins/bare-layout/index.ts"],
  "mcp": {
    "servers": {
      "angular": {
        "type": "local",
        "command": ["npx", "-y", "@angular/cli", "mcp"],
      },
    },
  },
  "providers": {
    "localai": {
      "package": "@ai-sdk/openai-compatible",
      "name": "LocalAI (local)",
      "settings": {
        "baseURL": "http://localhost:8080/v1",
        "modelsDiscovery": {
          "enabled": true,
        },
      },
    },
  },
  "policies": [
    { "action": "provider.use", "resource": "opencode", "effect": "deny" },
    { "action": "provider.use", "resource": "ollama", "effect": "deny" },
  ],
  "references": {
    "plan": {
      "path": "~/.opencode/plan",
      "description": "Plan files from plan mode",
    },
  },
  "experimental": {
    "todo": true,
  },
}
