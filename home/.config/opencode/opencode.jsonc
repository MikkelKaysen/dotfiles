{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "quick-message",
  "mcp": {
    "servers": {
      "angular": {
        "type": "local",
        "command": ["npx", "-y", "@angular/cli", "mcp"],
      },
    },
  },
  "providers": {
    "itm-gw": {
      "package": "@ai-sdk/openai-compatible",
      "name": "IT Minds LLM Gateway",
      "settings": {
        "litellm": true,
        "baseURL": "{env:ITM_LLM_GW_URL}",
        "apiKey": "{env:ITM_LLM_GW_KEY}",
      },
    },
    "localai": {
      "package": "@ai-sdk/openai-compatible",
      "name": "LocalAI (local)",
      "settings": {
        "baseURL": "http://localhost:8080/v1",
        "modelsDiscovery": {
          "enabled": true,
        },
      },
    },
  },
  "references": {
    "plan": {
      "path": "~/.opencode/plan",
      "description": "Plan files from plan mode",
    },
  },
  "experimental": {
    "todo": true,
  },
}
